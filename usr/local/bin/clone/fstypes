# maps filesystem names of 'parted' command to 'mkfs' command
# the last two fields are the min & max sector size respectively; if any of them
# are zero the page size is assumed
# to support comments after the end of a line the last field MUST be delimited
# by a colon

btrfs:mkfs.btrfs --force -q:0:0: # no subvolumes supported!
ext2:mkfs.ext2 -q -F -F:1024:4096
ext3:mkfs.ext3 -q -F -F:1024:4096
ext4:mkfs.ext4 -q -F -F:1024:4096
fat12:mkfs.fat -I -F12:512:4096
fat16:mkfs.fat -I -F16:512:4096
fat32:mkfs.fat -I -F32:512:4096
jfs:mkfs.jfs -q:512:4096
linux-swap(v1):mkswap -f
ntfs:mkfs.ntfs --force -q:256:4096
reiserfs:mkfs.reiserfs -ffq:512:8192
udf:mkfs.udf --utf8:512:32768
xfs:mkfs.xfs -fq:512:32768
hfs+:mkfs.hfsplus:0:0:    # case insensitive
hfsx:mkfs.hfsplus -s:0:0: # case sensitive
