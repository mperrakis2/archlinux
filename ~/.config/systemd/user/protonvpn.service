# https://protonvpn.com/support/wireguard-manual-linux/
# config file: /etc/wireguard/NL-FREE-409094.conf (must be less than 15 chars)
# enable user service: systemctl --user enable protonvpn.service
[Unit]
Description=Proton Vpn

[Service]
Type=oneshot
ExecStart=bash -c 'zone=$(curl --fail https://ipapi.co/timezone); wg-quick up NL-FREE-409094; sudo timedatectl set-timezone "$zone"'
ExecStop=bash -c 'wg-quick down NL-FREE-409094 && sudo timedatectl set-timezone $(tzupdate -p)'
RemainAfterExit=yes

[Install]
WantedBy=default.target
