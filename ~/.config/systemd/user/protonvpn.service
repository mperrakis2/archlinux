# https://protonvpn.com/support/wireguard-manual-linux/
# config file: /etc/wireguard/NL-FREE-409094.conf (must be less than 15 chars)
# enable user service: systemctl --user enable protonvpn.service
[Unit]
Description=Proton Vpn

[Service]
Type=oneshot
ExecStart=bash -c 'zone=$(tzupdate -p); wg-quick up NL-FREE-409094; sudo timedatectl set-timezone "$zone"'
ExecStop=wg-quick down NL-FREE-409094
RemainAfterExit=yes

[Install]
WantedBy=default.target
