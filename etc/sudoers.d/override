# allow members of group sudo to execute any command without password
%wheel ALL=(ALL:ALL) NOPASSWD:ALL

# allow all users to run an virus scan/clean without password
ALL ALL=NOPASSWD: /usr/sbin/av.sh

# allow all users to run environment setup
ALL ALL=NOPASSWD: /usr/lib/systemd/scripts/envycontrol.sh

# Set default EDITOR to restricted version of nano, and do not allow visudo to
# use EDITOR/VISUAL.
Defaults editor=/usr/bin/rnano, !env_editor

Defaults rootpw
Defaults passwd_timeout=0
