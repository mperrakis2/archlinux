[Unit]
Description=Enable/Disable nvidia services & update X Intel conf file

Before=nvidia-hibernate.service
Before=nvidia-suspend.service
Before=nvidia-suspend-then-hibernate.service
Before=nvidia-resume.service
Before=nvidia-persistenced.service
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/usr/lib/systemd/scripts/toggle_graphics.sh

[Install]
WantedBy=multi-user.target
